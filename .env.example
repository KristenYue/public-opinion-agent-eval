LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-me
LLM_MODEL=your-model
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_MAX_INPUT_CHARS=50000
RETRIEVER_BACKEND=hybrid
RETRIEVAL_MIN_SCORE=0.04
MAX_REQUEST_CHARS=100000
MAX_TOOL_CALLS=8

# Production V2: configure both or neither. The API refuses partial durable setup.
# Compose requires this value and does not provide a repository default.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://opinion_agent:replace-me@postgres:5432/opinion_agent
REDIS_URL=redis://redis:6379/0
ARQ_QUEUE_NAME=opinion-agent
ARQ_MAX_JOBS=2
ARQ_JOB_TIMEOUT_SECONDS=300
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_SECONDS=5
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_INTERVAL_SECONDS=20
# Runtime shadow is an opt-in comparison path. Keep false until migration 0003
# is applied and the pinned shadow dependency is installed.
RUNTIME_SHADOW_ENABLED=false
RUNTIME_SHADOW_CANDIDATE=agent-runtime-quality-platform@0.6.0.dev0
RUNTIME_SHADOW_TIMEOUT_SECONDS=120
RUNTIME_SHADOW_LEASE_SECONDS=60
RUNTIME_SHADOW_CHECKPOINT_PATH=/tmp/opinion-agent-shadow/runtime.sqlite3
# Optional stable pod/process identity; generated automatically when omitted.
WORKER_ID=
MODEL_VERSION=runtime-config-v1
TOOLSET_VERSION=v2-job-worker-1
POLICY_VERSION=event_aware_cascade_v1
V2_PROJECT_ID=11111111-1111-1111-1111-111111111111
V2_PROJECT_NAME=Local V2 Project
V2_PROJECT_CREATED_BY=compose-bootstrap
API_PORT=8000
READINESS_TIMEOUT_SECONDS=3
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-another-long-random-secret
